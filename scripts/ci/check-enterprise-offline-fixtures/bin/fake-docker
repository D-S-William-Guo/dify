#!/usr/bin/env bash
# Fake docker shim for B7 offline fixture tests.
# Configuration is read from the environment:
#   FAKE_DOCKER_IMAGES         space-separated list of images that "exist" locally
#   FAKE_DOCKER_COMMIT_SHA     COMMIT_SHA value reported for enterprise images
#   FAKE_DOCKER_COMPOSE_IMAGES newline-separated image list returned by `config --images`
#   FAKE_DOCKER_LOG            file each invocation is appended to (assert no build/pull/save in dry-run)
#   FAKE_DOCKER_NO_DIGEST      space-separated images that must report an empty RepoDigest
#   FAKE_DOCKER_WEB_CONTEXT_LISTING captures regular files visible to the Web build
#   FAKE_DOCKER_SAVE_STYLE     legacy (default) or docker29 Config paths
#   FAKE_DOCKER_SAVE_CASE      missing, duplicate, nonregular, malformed, oversized, inconsistent

set -euo pipefail

log() {
  if [[ -n "${FAKE_DOCKER_LOG:-}" ]]; then
    printf 'docker %s\n' "$*" >> "$FAKE_DOCKER_LOG"
  fi
}

images_file="${FAKE_DOCKER_IMAGES:-}"
commit_sha="${FAKE_DOCKER_COMMIT_SHA:-1111111111111111111111111111111111111111}"

has_image() {
  local img="$1"
  for candidate in $images_file; do
    [[ "$candidate" == "$img" ]] && return 0
  done
  return 1
}

image_hash() {
  printf '%s' "$1" | sha256sum | cut -c1-64
}

repository_name() {
  local image="$1"
  local last="${image##*/}"
  if [[ "$last" == *:* ]]; then
    printf '%s\n' "${image%:*}"
  else
    printf '%s\n' "$image"
  fi
}

cmd="$1"
shift || true

log "$cmd $*"

case "$cmd" in
  compose)
    # docker compose --env-file X -f Y -f Z config --images
    while [[ $# -gt 0 ]]; do
      case "$1" in
        config)
          shift || true
          if [[ "${1:-}" == "--images" ]]; then
            printf '%s\n' "${FAKE_DOCKER_COMPOSE_IMAGES:-}"
            exit 0
          fi
          ;;
        *)
          shift || true
          ;;
      esac
    done
    exit 0
    ;;
  image)
    sub="${1:-}"
    shift || true
    if [[ "$sub" == "inspect" ]]; then
      img="${1:-}"
      shift || true
      fmt=""
      if [[ "${1:-}" == "--format" ]]; then
        fmt="$2"
        shift 2 || true
      fi
      if ! has_image "$img"; then
        exit 1
      fi
      case "$fmt" in
        *"Config.Env"*)
          printf 'COMMIT_SHA=%s\n' "$commit_sha"
          ;;
        *".Id"*)
          if [[ " ${FAKE_DOCKER_BAD_ID:-} " == *" $img "* ]]; then
            printf 'not-an-id\n'
          else
            printf 'sha256:%s\n' "$(image_hash "$img")"
          fi
          ;;
        *"RepoDigests"*)
          if [[ " ${FAKE_DOCKER_NO_DIGEST:-} " == *" $img "* ]]; then
            printf '[]\n'
          elif [[ " ${FAKE_DOCKER_MISMATCH_DIGEST:-} " == *" $img "* ]]; then
            printf '["other.example/mismatch@sha256:%s"]\n' "$(image_hash "mismatch:$img")"
          elif [[ " ${FAKE_DOCKER_MULTIPLE_DIGEST:-} " == *" $img "* ]]; then
            printf '["other.example/mismatch@sha256:%s","%s@sha256:%s"]\n' \
              "$(image_hash "mismatch:$img")" "$(repository_name "$img")" "$(image_hash "digest:$img")"
          else
            printf '["%s@sha256:%s"]\n' "$(repository_name "$img")" "$(image_hash "digest:$img")"
          fi
          ;;
        *)
          ;;
      esac
      exit 0
    fi
    exit 0
    ;;
  save)
    out="${1:-}"
    shift || true
    if [[ "$out" == "-o" ]]; then
      out="${1:-}"
      shift || true
    fi
    if [[ -n "$out" ]]; then
      python3 - "$out" "${FAKE_DOCKER_SAVE_STYLE:-legacy}" "${FAKE_DOCKER_SAVE_CASE:-}" "$@" <<'PY'
import hashlib
import io
import json
import sys
import tarfile

output, style, case, *images = sys.argv[1:]
records = []
configs = []
for image in images:
    digest = hashlib.sha256(image.encode()).hexdigest()
    config = f"blobs/sha256/{digest}" if style == "docker29" else f"{digest}.json"
    records.append({"Config": config, "RepoTags": [image], "Layers": []})
    configs.append(config)
if case == "inconsistent" and records:
    records[0]["Config"] = f"{'0' * 64}.json"
payload = json.dumps(records).encode() + b"\n"
if case == "malformed":
    payload = b"{not-json\n"
elif case == "oversized":
    payload = b"[" + b" " * (1024 * 1024) + b"]"

with tarfile.open(output, "w") as archive:
    if case != "missing":
        info = tarfile.TarInfo("manifest.json")
        if case == "nonregular":
            info.type = tarfile.SYMTYPE
            info.linkname = "elsewhere"
            archive.addfile(info)
        else:
            info.size = len(payload)
            archive.addfile(info, io.BytesIO(payload))
            if case == "duplicate":
                archive.addfile(info, io.BytesIO(payload))
    for config in configs:
        data = b"{}\n"
        info = tarfile.TarInfo(config)
        info.size = len(data)
        archive.addfile(info, io.BytesIO(data))
PY
    fi
    exit 0
    ;;
  pull)
    exit 0
    ;;
  build)
    context="${@: -1}"
    if [[ -n "${FAKE_DOCKER_WEB_CONTEXT_LISTING:-}" && "$*" == *"/web/Dockerfile"* ]]; then
      if find "$context" \( -name '.env' -o -name '.env.*' \) -print -quit | grep -q .; then
        echo "synthetic Web context still contains an environment path" >&2
        exit 1
      fi
      find "$context" -type f -printf '%P\n' | sort > "$FAKE_DOCKER_WEB_CONTEXT_LISTING"
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
